#!/usr/bin/env python3
"""next scan [--cwd DIR] | kind KEY | ask KEY FP | answer | did | undo | trust | promise:
the repository scan, trust ladder and promises behind /wanjang:manager (bin/manager imports this file).

  scan    print repository candidates, one per line: key<TAB>fp<TAB>summary (uncommitted, todo, memory-next,
          unpushed, run:<folder>). Never runs tests. Nothing is filtered: bin/manager's ledger knows what was asked.
          Open promises for the project (see `promise`) come first: promise:<id><TAB><fp><TAB>you asked me to: ...
          Their stored `--when` conditions run here (10 s timeout, at most 3 per scan), never from a hook.
  promise add "WHAT" [--words W] [--why Y] [--at T] [--when CMD] [--every 30m] [--for 14d] [--fp E]
          [--by user|agent] [--cwd DIR]: write down a later check. Needs --at or --when. T is ISO 8601 (local
          without an offset) or +30m|+2h|+3d. Prints id<TAB>due<TAB>where it comes up. Exit 4 = duplicate (id printed).
          list [--all] [--json] | set ID [--at T] [--when CMD] [--what W] | done ID [--note N] | drop ID
          | due [--cwd DIR]  (read-only, runs no condition: the SessionStart notice)
  kind KEY [--what W]: the kind KEY and its action map to (verify, test, docs, commit, relay, resume, promise,
          other, or outward: always asked).
  ask KEY FP [--what W] [--cwd DIR]: print one word, `ask` or `auto` (do it without asking: the trust ladder
          below). An `auto` opens a running action; asking again for the same KEY and FP while it runs prints `auto`.
  answer KEY FP yes|no [--what W]   the user's answer to an asked question: yes counts toward the kind, no resets
          it. Prints one line when the kind is newly trusted.
  did KEY FP ok|failed|ask [--commit HASH] [--files F...] [--note N]: the outcome of an `auto` action (ask: it
          was not done after all and is being asked). Prints the one-line report. Exit 1 = no such running action.
  undo    undo the last auto action and reset its kind. Exit 4 = refused, nothing changed.
  trust [off | on | KIND ask | KIND reset] [--json]: the ladder table, or switch it, pin a kind, zero a kind.
          A kind (verify, test, docs, commit, relay) is `auto` after 3 yeses within 14 days, the first of them
          24 h old; at most 6 auto actions per project per 24 h, one at a time (bin/manager adds: 2 per tick).
          resume (task:, run:), promise:, other keys and anything outward (push, deploy, publish, migrations,
          deletes, installs, messages, payments; checked on KEY and --what) are always asked.

Promises: ${CLAUDE_CONFIG_DIR:-~/.claude}/wanjang/promises.json (one per user, locked by promises.lock).
Trust: ${CLAUDE_CONFIG_DIR:-~/.claude}/wanjang/next/trust/<sha8 of the project>.json (per project; worktrees share it).
Clock: env WANJANG_NOW (epoch seconds) replaces the current time, for tests.

Examples:
  next scan | cut -f1,3         # keys and summaries
  next kind commit:x --what "commit and push"   # outward
  next ask uncommitted 3fa9c1d2 --what "commit the files" --cwd ~/repo   # ask | auto

Exit codes: 0 ok, 1 unknown promise or no running auto action, 2 bad arguments, 4 duplicate promise or undo refused."""
import argparse, fcntl, glob, hashlib, json, os, random, re, signal, subprocess, sys, tempfile, time, unicodedata
from datetime import datetime

DAY7, RENEW = 7 * 86400, 6 * 86400


def clock():
    return num(os.environ.get("WANJANG_NOW")) or time.time()


def sha(s):
    return hashlib.sha1(str(s).encode()).hexdigest()[:8]


def num(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return 0.0


def verdict(d, exists, now):
    """off | create | recreate | keep: what to do with a session cron made at d["cron_created"] (bin/manager)"""
    if d.get("on") is not True:
        return "recreate" if ("on" not in d and exists) else "off"
    if not exists:
        return "create"
    return "keep" if 0 < num(d.get("cron_created")) and now - num(d.get("cron_created")) < RENEW else "recreate"


def sdir():
    return os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "wanjang", "next")


def ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def git(cwd, *args):
    try:
        r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=15, errors="replace")
        return r.stdout if r.returncode == 0 else ""
    except Exception:
        return ""


def one(s, n=160):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def candidates(cwd):
    if not git(cwd, "rev-parse", "--git-dir").strip():
        return
    head = git(cwd, "rev-parse", "--short", "HEAD").strip()
    por = git(cwd, "status", "--porcelain")
    diff = git(cwd, "diff", "HEAD")
    if por.strip():
        files = [l[3:] for l in por.splitlines()]
        more = f" +{len(files) - 3} more" if len(files) > 3 else ""
        yield "uncommitted", sha(head + por + diff), one(f"{len(files)} files changed: {', '.join(files[:3])}{more}")
    todos, cur = [], ""
    for l in diff.splitlines():
        if l.startswith("+++ "):
            cur = l[6:] if l.startswith("+++ b/") else l[4:]
        elif l.startswith("+") and re.search(r"\b(TODO|FIXME|XXX)\b", l):
            todos.append(f"{cur}: {l[1:].strip()}")
    if todos:
        yield "todo", sha("\n".join(todos)), one(f"{len(todos)} new TODO/FIXME/XXX, first {todos[0]}")
    up = git(cwd, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}").strip()
    ahead = git(cwd, "rev-list", "--count", "@{u}..HEAD").strip() if up else ""
    if ahead.isdigit() and int(ahead):
        yield "unpushed", sha(git(cwd, "rev-parse", "HEAD").strip()), \
            f"{ahead} commit{'s' if ahead != '1' else ''} not pushed to {up}"
    root = git(cwd, "rev-parse", "--show-toplevel").strip()
    try:
        lines = open(os.path.join(root, "MEMORY.md"), errors="replace").read().splitlines()
    except OSError:
        lines = []
    for i, l in enumerate(lines):
        h = re.match(r"(#+)\s+(.*)", l)
        if h and "next" in h.group(2).lower():
            body = []
            for l2 in lines[i + 1:]:
                h2 = re.match(r"(#+)\s", l2)
                if h2 and len(h2.group(1)) <= len(h.group(1)):
                    break
                body.append(l2)
            if "".join(body).strip():
                first = next(x for x in body if x.strip())
                yield "memory-next", sha("\n".join(body).strip()), one(f"MEMORY.md {h.group(2)}: {first.strip()}")
                break
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    for lp in sorted(glob.glob(f"{common}/wanjang/*/log.md")) if common else []:
        try:
            mt = os.path.getmtime(lp)
            txt = open(lp, errors="replace").read().splitlines()
        except OSError:
            continue
        if not txt or txt[0].strip() != "Status: in progress" or time.time() - mt > DAY7:
            continue
        name, goal = os.path.basename(os.path.dirname(lp)), ""
        for j, l in enumerate(txt):
            if l.lstrip("#* ").lower().startswith("goal"):
                goal = l.split(":", 1)[1].strip() if ":" in l else ""
                goal = goal or next((x.strip() for x in txt[j + 1:] if x.strip()), "")
                break
        yield f"run:{name}", sha(name + str(int(mt))), one(f"run in progress, goal: {goal}" if goal else "run in progress")


# ---- promises
PMAX, PKEEP, PEXP, PEVERY, PCOND, PBATCH = 200, 30 * 86400, 14 * 86400, 1800, 10, 3
DUR = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def ppath():
    return os.path.join(os.path.dirname(sdir()), "promises.json")


def pread():
    try:
        v = json.load(open(ppath()))["promises"]
        return [p for p in v if isinstance(p, dict) and p.get("id")]
    except (OSError, ValueError, KeyError, TypeError):
        return []


def pmutate(fn, now):
    """read, fn(list) -> result, write back, all under flock; a write failure prints one line and returns None"""
    d = os.path.dirname(ppath())
    try:
        os.makedirs(d, exist_ok=True)
        with open(ppath() + ".lock", "w") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            ps = pread()
            r = fn(ps)
            ps = [p for p in ps if p.get("status") == "open" or now - num(p.get("closed")) < PKEEP]
            fd, tmp = tempfile.mkstemp(dir=d, suffix=".tmp")
            with os.fdopen(fd, "w") as f:
                json.dump({"promises": ps}, f)
            os.replace(tmp, ppath())
            return r
    except OSError as e:
        print(f"next: cannot save promises ({d}): {e}", file=sys.stderr)


def project(cwd):
    cwd = os.path.realpath(cwd)
    c = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    return os.path.dirname(os.path.realpath(c)) if c else cwd


def when_ts(t, now):
    m = re.fullmatch(r"\+(\d+)([smhd])", t or "")
    return now + int(m.group(1)) * DUR[m.group(2)] if m else ts(t or "")


def dur(t):
    m = re.fullmatch(r"(\d+)([smhd])", t or "")
    return int(m.group(1)) * DUR[m.group(2)] if m else None


def lt(t):
    return datetime.fromtimestamp(t).strftime("%a %d %H:%M")


def norm(s):
    return " ".join(str(s).lower().split())


def pstate(p, now):
    """(None | 'due' | 'expired', reason) for an open promise"""
    if now >= num(p.get("expires")):
        return "expired", f"gave up after {round((num(p['expires']) - num(p.get('created'))) / 86400)}d"
    if p.get("at") is not None and now < num(p["at"]):
        return None, ""
    w, rc = p.get("when"), p.get("last_rc")
    if not w:
        return "due", "time passed"
    if rc in (126, 127):
        return "due", f"its check cannot run: `{w}`"
    if rc == 0:
        return "due", f"`{w}` exits 0" + (f": {p['last_out']}" if p.get("last_out") else "")
    return None, ""


def pline(p, reason):
    return f"you asked me to: {one(p.get('words') or p.get('what', ''))}; due: {reason}"


def pfp(p, now):
    return f"{p['id']}:{int(num(p.get('snoozes')))}:{datetime.fromtimestamp(now):%Y-%m-%d}"


def run_cond(cmd, cwd):
    """(rc, last output line); a timeout is rc -1; 126/127 mean the check cannot run"""
    try:
        with tempfile.TemporaryFile() as out:
            pr = subprocess.Popen(["sh", "-c", cmd], cwd=cwd, stdin=subprocess.DEVNULL, stdout=out,
                                  stderr=subprocess.STDOUT, start_new_session=True)
            try:
                rc = pr.wait(PCOND)
            except subprocess.TimeoutExpired:
                os.killpg(pr.pid, signal.SIGKILL)
                pr.wait()
                return -1, "timed out"
            out.seek(0)
            ls = out.read().decode(errors="replace").strip().splitlines()
            return rc, one(ls[-1]) if ls else ""
    except OSError:
        return 127, "cannot start"


def promise_scan(proj, now, batch=PBATCH):
    """(lines for due promises, conditions run): runs stored conditions (the only place they run), at most batch"""
    mine = lambda p: p.get("status") == "open" and p.get("project") == proj
    gone = []

    def pick(ps):
        run = sorted((p for p in ps if mine(p) and p.get("when") and (p.get("at") is None or now >= num(p["at"]))
                      and now < num(p["expires"]) and now - num(p.get("last_eval")) >= num(p.get("every") or PEVERY)),
                     key=lambda p: num(p.get("last_eval")))[:max(0, batch)]
        for p in run:
            p["last_eval"] = now  # claimed: a concurrent scan skips it
        for p in ps:
            if mine(p) and now >= num(p.get("expires")):
                p["status"], p["closed"] = "expired", now
                gone.append(dict(p))
        return [(p["id"], p["when"]) for p in run]

    todo = pmutate(pick, now) or []
    res = {i: run_cond(c, proj) for i, c in todo}
    if res:
        def put(ps):
            for p in ps:
                if p["id"] in res:
                    p["last_rc"], p["last_out"] = res[p["id"]]
        pmutate(put, now)
    out = [(p, pstate(p, now)[1]) for p in gone]
    for p in pread():
        if mine(p):
            k, why = pstate(p, now)
            if k == "due":
                out.append((p, why))
    return [f"promise:{p['id']}\t{pfp(p, now)}\t{pline(p, why)}" for p, why in out], len(todo)


def promise_cmd(a, now):
    c = a.pcmd
    if c == "add":
        at = when_ts(a.at, now) if a.at else None
        at = int(at) if at else at
        ev, fo = dur(a.every), dur(a.__dict__["for"])
        if not (a.at or a.when) or (a.at and at is None) or ev is None or ev < 60 or fo is None or not a.what.strip():
            print('usage: next promise add "WHAT" (--at T | --when CMD) [--every 30m, at least 1m] [--for 14d] [--words W] [--why Y] '
                  '[--fp E] [--by user|agent] [--cwd DIR]  (T: ISO 8601 or +30m|+2h|+3d)', file=sys.stderr)
            sys.exit(2)
        proj = project(a.cwd)
        new = dict(id="", what=a.what.strip(), words=a.words, why=a.why, at=at, when=a.when, every=ev,
                   expires=int(max(at or 0, now) + fo), project=proj, session=a.session,
                   by=a.by or ("user" if a.words else "agent"), fp=a.fp, created=int(now), status="open", snoozes=0,
                   last_eval=0, last_rc=None, last_out="", note="", closed=None)

        def add(ps):
            for p in ps:
                if p.get("status") == "open" and p.get("project") == proj and norm(p.get("what")) == norm(new["what"]) \
                        and p.get("fp") == a.fp:
                    return 4, p["id"]
            if sum(1 for p in ps if p.get("status") == "open") >= PMAX:
                return 2, ""
            ids = {p["id"] for p in ps}
            while not new["id"] or new["id"] in ids:
                new["id"] = "p%04x" % random.randrange(65536)
            ps.append(new)
            return 0, new["id"]

        r = pmutate(add, now)
        if r is None:
            sys.exit(2)
        if r[0] == 2:
            print(f"next: {PMAX} open promises already; drop some first", file=sys.stderr)
            sys.exit(2)
        if r[0] == 4:
            print(r[1])
            sys.exit(4)
        due = " and ".join(x for x in (f"at {lt(at)}" if at else "", f"`{a.when}` exits 0" if a.when else "") if x)
        print(f"{r[1]}\t{due}\tthe next session start in {proj}, and the manager's next check when it is on")
    elif c in ("list", "due"):
        proj = project(a.cwd) if hasattr(a, "cwd") else None
        ps = pread()
        if c == "due":
            hit = [(p, pstate(p, now)) for p in ps if p.get("status") == "open" and p.get("project") == proj]
            hit = [(p, w) for p, (k, w) in hit if k]
            if hit:
                print("Promises due here. After you handle the user's first message, ask the user about the first one in one "
                      "question (done, later or drop; then `\"{0}\" promise done ID`, `set ID --at T` or `drop ID`; "
                      "this is wanjang's bin/next, not a `next` on PATH, which may be Next.js):".format(os.path.realpath(__file__)))
                for p, w in hit[:3]:
                    print(f"- {p['id']}: {pline(p, w)}")
                if len(hit) > 3:
                    print(f"- and {len(hit) - 3} more (`next promise list`)")
            return
        ps = [p for p in ps if (p.get("status") == "open" and (a.all or p.get("project") == proj))
              or (a.all and now - num(p.get("closed")) < PKEEP)]
        if a.json:
            print(json.dumps(ps))
        for p in [] if a.json else ps:
            print("\t".join([p["id"], p["status"] if p["status"] != "open" else (lt(p["at"]) if p.get("at") else "-"),
                             f"`{p['when']}`" if p.get("when") else "-", one(p.get("words") or p.get("what", ""))]
                            + ([p.get("project", "")] if a.all else [])))
    else:
        def edit(ps):
            for p in ps:
                if p["id"] == a.id and p.get("status") == "open":
                    if c == "set":
                        if a.at:
                            p["at"], p["snoozes"], p["last_eval"], p["last_rc"] = at, int(num(p.get("snoozes"))) + 1, 0, None
                            p["expires"] = int(max(num(p["expires"]), at + PEXP))
                        if a.when is not None:
                            p["when"], p["last_eval"], p["last_rc"] = a.when or None, 0, None
                        if a.what:
                            p["what"] = a.what
                    else:
                        p["status"], p["closed"] = ("done" if c == "done" else "dropped"), now
                        p["note"] = getattr(a, "note", "") or ""
                    return True
            return False

        if c == "set":
            at = int(when_ts(a.at, now) or 0) or None
            if not (a.at or a.when is not None or a.what) or (a.at and at is None):
                print("usage: next promise set ID [--at T] [--when CMD] [--what W]", file=sys.stderr)
                sys.exit(2)
        if not pmutate(edit, now):
            print(f"next: no open promise {a.id}", file=sys.stderr)
            sys.exit(1)


# ---- trust ladder: a kind of work the user keeps saying yes to is done without asking, then reported
PROMOTE = ("verify", "test", "docs", "commit", "relay")
# never auto, whatever the key: matched on the key and --what (the skill's outward rule is primary). A denylist is
# never complete, so `auto` also needs SAFE below: anything unrecognised is asked.
OUTWARD = re.compile(
    r"push|deploy|publish|release|\bship|\blive\b|roll ?out|promot|\bprod\b|production|migrat|alter table|schema|"
    r"\bdelet|\bdrop|\brm\b|rmdir|unlink|\bremov|truncat|purge|\bwipe|\beras|\bclean|"
    r"install|upgrad|depend|\b(npm|pnpm|bun|pip3?|pipx|gem|cargo|composer|poetry|uv) (i|add|install|update|upgrade|up|get)\b|"
    r"\b(yarn|brew|apt|apt get|go get)\b|terraform|kubectl|\bhelm\b|\bapply\b|"
    r"\bsync|remote|origin|\breset|merge|rebase|\bpr\b|pull request|\bgh\b|\bissue|"
    r"upload|\bscp\b|rsync|\bftp|\bcurl\b|wget|"
    r"\bsend|messag|notif|\bping|\btell|\bmail|\bemail|slack|tweet|\bdm\b|\btext|\brepl(y|ies)\b|\bpost|comment on|"
    r"\bcall\b|invit|\bpay|\bpaid|\bbuy|purchas|\bcharg|\bbill|subscri|transfer|\bfund|invoice|refund")
# the same text with every separator dropped, so "p-u-s-h it" or "pu sh" is still seen; only stems long enough
# not to turn up across word joins
JOINED = re.compile(r"push|deploy|publish|release|migrat|delet|install|upgrad|upload|rollout|truncat|purge|rmdir|unlink|"
                    r"terraform|kubectl|production|email|tweet|subscri|transfer|invoice|rebase|rsync|payment")
TESTS = (r"(re ?)?run (the |all )?((unit|integration|e2e|failing|affected) )?"
         r"(tests?|test suite|specs?|lint|linters?|typecheck|type check|build check)( again)?|(lint|typecheck)( again)?")
# a kind is `auto` only when the whole --what is one of its own short closed forms: an extra clause or an
# unknown word is asked. relay's `to` must be the session the key names.
SAFE = {k: re.compile(v) for k, v in (
    ("test", TESTS),
    ("verify", TESTS + r"|(verify|check|confirm|review|recheck)( it| the (fix|change|changes|work|build|result|results|tests))?"
                       r"( with the checker)?"),
    ("docs", r"(update|fix|edit|correct|tidy|reword|rewrite|clarify) (the )?"
             r"(readme|docs?|documentation|comments?|docstrings?|changelog|notes|[a-z0-9]+ md)"),
    ("commit", r"commit( it| (the |these |my )?(files|listed files|changes|work|verified work|fix|docs))?( (i|we) changed)?"),
    ("relay", r"(report back|(relay|hand|pass) (a |the )?(note|results?|report)( back)?) to (?P<to>[a-z0-9 ]+)"))}
CHAIN = re.compile(r"[,;&|]|\b(and|then|also|plus)\b")


def plain(s):
    """printable ASCII only: words() drops every other character (other scripts, emoji, zero-width marks), so
    text holding any of them must not reach the full match"""
    return bool(re.fullmatch(r"[\x20-\x7e]*", unicodedata.normalize("NFKC", str(s or ""))))


def safe(k, key, what):
    """--what is the kind's own wording, one clause, nothing outward"""
    w = words(what)
    m = SAFE[k].fullmatch(w) if k in SAFE and plain(what) else None
    return bool(m) and not CHAIN.search(unicodedata.normalize("NFKC", what or "").lower()) and not outward(what) \
        and (k != "relay" or (plain(key.partition(":")[2]) and m.group("to") == words(key.partition(":")[2])))
YES_N, YES_AGE, YES_WIN, YES_KEEP, AUTO_KEEP, DAYMAX = 3, 86400, 14 * 86400, 10, 20, 6
STALE = 3600  # ponytail: a running auto action never closed by `did` stops blocking after an hour


def words(s):
    """lowercase words, one space apart: what the guard reads"""
    return " ".join(re.findall(r"[a-z0-9]+", unicodedata.normalize("NFKC", str(s or "")).lower()))


def outward(s):
    w = words(s)
    return bool(OUTWARD.search(w) or JOINED.search(w.replace(" ", "")))


def kind_of(key, what=""):
    if outward(key) or outward(what):
        return "outward"
    if key == "uncommitted":
        return "commit"
    p, colon, _ = key.partition(":")
    if p in PROMOTE and colon:
        return p
    return {"task": "resume", "run": "resume", "promise": "promise"}.get(p, "other")


def tload(cwd):
    """(trust state, path); a missing, corrupt or unreadable file reads as empty: everything is asked"""
    proj = project(cwd)
    p = os.path.join(sdir(), "trust", f"{sha(proj)}.json")
    try:
        t = json.load(open(p))
        if not isinstance(t, dict):
            raise ValueError
    except (OSError, ValueError):
        t = {}
    ks = t.get("kinds") if isinstance(t.get("kinds"), dict) else {}
    lst = lambda v: v if isinstance(v, list) else []
    kinds = {k: {"yes": [num(y) for y in lst(v.get("yes")) if num(y)], "since": num(v.get("since")), "pin": v.get("pin") is True}
             for k, v in ks.items() if k in PROMOTE and isinstance(v, dict)}
    return {"v": 1, "root": proj, "off": t.get("off") is True, "kinds": kinds,
            "auto": [e for e in lst(t.get("auto")) if isinstance(e, dict)]}, p


def tsave(t, p):
    for k in t["kinds"].values():
        k["yes"] = k["yes"][-YES_KEEP:]
    t["auto"] = t["auto"][-AUTO_KEEP:]
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), suffix=".tmp")
        with os.fdopen(fd, "w") as f:
            json.dump(t, f)
        os.replace(tmp, p)
        return True
    except OSError as e:
        print(f"next: cannot save trust ({os.path.dirname(p)}): {e}", file=sys.stderr)
        return False


def kd(t, k):
    return t["kinds"].setdefault(k, {"yes": [], "since": 0.0, "pin": False})


def demote(t, k, now, unpin=False):
    if k in PROMOTE:
        e = kd(t, k)
        e["yes"], e["since"] = [], now
        e["pin"] = e["pin"] and not unpin


def yeses(t, k, now):
    """(yeses that count, when the kind turns auto or None)"""
    ys = sorted(y for y in (t["kinds"].get(k) or {}).get("yes", []) if now - y <= YES_WIN)
    return len(ys), (ys[0] + YES_AGE if len(ys) >= YES_N else None)


def level(t, k, now):
    if t["off"] or k not in PROMOTE or (t["kinds"].get(k) or {}).get("pin"):
        return "ask"
    w = yeses(t, k, now)[1]
    return "auto" if w and w <= now else "ask"


def dropped(t, cwd, now):
    """an auto commit no branch or HEAD contains any more (the user dropped it) resets commit"""
    if not git(cwd, "rev-parse", "--git-dir").strip():
        return False
    for e in t["auto"]:
        if e.get("kind") == "commit" and e.get("state") == "ok" and e.get("commit") and now - num(e.get("at")) < YES_WIN \
                and not git(e.get("cwd") or cwd, "branch", "--contains", e["commit"]).strip():
            e["state"] = "dropped"
            demote(t, "commit", now)
            return True
    return False


def ask_level(a, k, now):
    """ask | auto for a.key/a.fp/a.what/a.cwd (a.session is recorded): the trust ladder's verdict"""
    t, p = tload(a.cwd)
    changed, v = dropped(t, a.cwd, now), "ask"
    au = t["auto"]
    run = [e for e in au if e.get("state") == "running" and now - num(e.get("at")) < STALE]
    if any(e.get("key") == a.key and e.get("fp") == sha(a.fp) for e in run):
        return "auto"  # asked again for the action already running (the manager re-checks what the inspector asked)
    done = [e for e in au if e.get("state") != "asked"]
    if safe(k, a.key, a.what) and level(t, k, now) == "auto" and not run \
            and sum(1 for e in done if now - num(e.get("at")) < 86400) < DAYMAX:
        au.append(dict(kind=k, key=a.key, fp=sha(a.fp), what=one(a.what), at=now, state="running",
                       session=getattr(a, "session", ""), cwd=os.path.realpath(a.cwd), commit="", files={},
                       yeses=yeses(t, k, now)[0]))
        changed, v = True, "auto"
    if changed and not tsave(t, p):
        v = "ask"  # an auto action that cannot be recorded cannot be undone
    return v


def fhash(f):
    try:
        return hashlib.sha1(open(f, "rb").read()).hexdigest()
    except OSError:
        return "-"


def trust_cmd(a, now):
    t, p = tload(a.cwd)
    c = a.cmd
    if c == "answer":
        k = kind_of(a.key, getattr(a, "what", ""))
        ch = False
        for e in t["auto"]:  # an `auto` the skill turned into a question
            if e.get("key") == a.key and e.get("fp") == sha(a.fp) and e.get("state") == "running":
                e["state"], ch = "asked", True
        if k not in PROMOTE:
            return ch and tsave(t, p)
        if a.reply == "no":
            demote(t, k, now)
            return tsave(t, p)
        n0 = yeses(t, k, now)[0]
        kd(t, k)["yes"].append(now)
        n, w = yeses(t, k, now)
        if tsave(t, p) and n0 < YES_N <= n and not t["off"] and not kd(t, k)["pin"]:
            print(f"{k} is trusted now ({n} yeses): from {'now' if w <= now else lt(w)} it is done without asking and "
                  f"reported. Always ask: /wanjang:manager trust {k} ask")
    elif c == "did":
        e = next((e for e in reversed(t["auto"]) if e.get("key") == a.key and e.get("fp") == sha(a.fp)
                  and e.get("state") == "running"), None)
        if e is None:
            print(f"next: no running auto action for {a.key}", file=sys.stderr)
            sys.exit(1)
        k, cwd = e.get("kind"), e.get("cwd") or a.cwd
        if a.outcome == "ask":
            t["auto"].remove(e)
            return tsave(t, p)
        if a.outcome == "ok":
            if k == "commit":
                full = git(cwd, "rev-parse", "--verify", "--quiet", f"{a.commit}^{{commit}}").strip() if a.commit else ""
                if not full:
                    print("next: did ok for commit needs --commit HASH of the commit made", file=sys.stderr)
                    sys.exit(2)
                e["commit"] = full
            if k == "docs":
                if not a.files:
                    print("next: did ok for docs needs --files with the files written", file=sys.stderr)
                    sys.exit(2)
                e["files"] = {os.path.realpath(os.path.join(cwd, f)): fhash(os.path.join(cwd, f)) for f in a.files}
            e["state"] = "ok"
            tsave(t, p)
            print(f"Done without asking ({k}, trusted after {int(num(e.get('yeses')))} yeses): {e.get('what')}"
                  + (f", {a.note}" if a.note else "") + f". Undo: /wanjang:manager undo · always ask: /wanjang:manager trust {k} ask")
        else:
            e["state"] = "failed"
            demote(t, k, now)
            tsave(t, p)
            print(f"Tried {e.get('what')} without asking; it failed: {a.note or 'no reason given'}. {k} is asked again from now.")
    elif c == "undo":
        e = next((e for e in reversed(t["auto"]) if e.get("state") != "asked"), None)
        if not e or e.get("state") != "ok":
            print("Nothing to undo: the last action done without asking here is already closed or there is none.")
            return
        k, cwd = e.get("kind"), e.get("cwd") or a.cwd
        if k == "commit":
            h = e.get("commit", "")
            head = git(cwd, "rev-parse", "HEAD").strip()
            if head != h:
                print(f"Not undone: HEAD is {head[:7] or 'unknown'}, not the auto commit {h[:7]}; nothing changed.")
                sys.exit(4)
            if git(cwd, "branch", "-r", "--contains", h).strip():
                print(f"Not undone: {h[:7]} is on a remote branch already; nothing changed.")
                sys.exit(4)
            if not git(cwd, "rev-parse", "--verify", "--quiet", f"{h}^").strip() or \
                    subprocess.run(["git", "-C", cwd, "reset", "-q", "--soft", f"{h}^"], capture_output=True).returncode:
                print(f"Not undone: cannot reset {h[:7]} (first commit?); nothing changed.")
                sys.exit(4)
            msg = f"Undone: commit {h[:7]} reset softly; its changes stay staged."
        elif k == "docs":
            fs = e.get("files") or {}
            moved = [f for f, hs in fs.items() if fhash(f) != hs]
            if moved:
                print("Not undone: changed since the auto edit: " + ", ".join(os.path.relpath(f, cwd) for f in moved)
                      + "; restored none.")
                sys.exit(4)
            r = subprocess.run(["git", "-C", cwd, "restore", "--", *fs], capture_output=True, text=True, errors="replace")
            if r.returncode:
                print(f"Not undone: git restore failed: {one(r.stderr)}; nothing changed.")
                sys.exit(4)
            msg = "Undone: restored " + ", ".join(os.path.relpath(f, cwd) for f in fs) + "."
        else:
            msg = f"Nothing to undo for {k} ({e.get('what')})."
        e["state"] = "undone"
        demote(t, k, now)
        tsave(t, p)
        print(f"{msg} {k} is asked again from now.")
    else:  # trust
        w = a.args
        if w in (["off"], ["on"]):
            t["off"] = w == ["off"]
            if tsave(t, p):
                print(f"Trust ladder {w[0]}" + (" (counts kept): everything is asked." if t["off"] else "."))
            return
        if len(w) == 2 and w[0] in PROMOTE and w[1] in ("ask", "reset"):
            if w[1] == "ask":
                kd(t, w[0])["pin"] = True
            else:
                demote(t, w[0], now, unpin=True)
            if tsave(t, p):
                print(f"{w[0]}: always asked." if w[1] == "ask" else f"{w[0]}: reset to 0 yeses, asked until trusted again.")
            return
        if w:
            print(f"usage: next trust [off | on | KIND ask | KIND reset]  (KIND: {', '.join(PROMOTE)})", file=sys.stderr)
            sys.exit(2)
        last = {}
        for e in t["auto"]:
            last[e.get("kind")] = e
        rows = []
        for k in PROMOTE:
            n, wh = yeses(t, k, now)
            lv = level(t, k, now)
            if lv == "ask" and wh and not t["off"] and not kd(t, k)["pin"]:
                lv = f"auto from {lt(wh)}"
            e = last.get(k)
            rows.append(dict(kind=k, level=lv, yeses=n, pin=kd(t, k)["pin"],
                             last=f"{lt(num(e.get('at')))} {e.get('state')}: {e.get('what')}" if e else ""))
        if a.json:
            print(json.dumps({"on": not t["off"], "kinds": rows}))
            return
        print(f"trust ladder {'off' if t['off'] else 'on'} for {t['root']}")
        for r in rows:
            print("\t".join([r["kind"], r["level"], f"{r['yeses']}/{YES_N}", "pinned" if r["pin"] else "-", r["last"] or "-"]))


def main():
    if sys.argv[1:2] in (["prompt"], ["stop"]):  # hooks loaded before 0.13.0 still call these: pass, never block
        sys.stdin.read()
        return 0
    par = argparse.ArgumentParser(prog="next", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    com = argparse.ArgumentParser(add_help=False)
    com.add_argument("--session", default=os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
    sub = par.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("scan", parents=[com])
    s.add_argument("--cwd", default=os.getcwd())
    s = sub.add_parser("kind")
    s.add_argument("key")
    s.add_argument("--what", default="")
    for n in ("ask", "answer", "did"):
        p = sub.add_parser(n, parents=[com])
        p.add_argument("key")
        p.add_argument("fp")
    sub.choices["ask"].add_argument("--what", default="")
    sub.choices["answer"].add_argument("reply", choices=("yes", "no"))
    sub.choices["answer"].add_argument("--what", default="")
    s = sub.choices["did"]
    s.add_argument("outcome", choices=("ok", "failed", "ask"))
    s.add_argument("--commit", default="")
    s.add_argument("--files", nargs="+", default=[])
    s.add_argument("--note", default="")
    sub.add_parser("undo", parents=[com])
    s = sub.add_parser("trust", parents=[com])
    s.add_argument("args", nargs="*")
    s.add_argument("--json", action="store_true")
    for n in ("ask", "answer", "did", "undo", "trust"):
        sub.choices[n].add_argument("--cwd", default=os.getcwd())
    pp = sub.add_parser("promise", parents=[com]).add_subparsers(dest="pcmd", required=True)
    s = pp.add_parser("add")
    s.add_argument("what")
    for n, dflt in (("words", ""), ("why", ""), ("at", None), ("when", None), ("every", "30m"), ("for", "14d"),
                    ("fp", ""), ("by", None)):
        s.add_argument("--" + n, default=dflt, **({"choices": ("user", "agent")} if n == "by" else {}))
    pp.add_parser("due")
    s = pp.add_parser("list")
    s.add_argument("--all", action="store_true")
    s.add_argument("--json", action="store_true")
    for n in ("list", "due", "add"):
        pp.choices[n].add_argument("--cwd", default=os.getcwd())
    s = pp.add_parser("set")
    s.add_argument("id")
    s.add_argument("--at")
    s.add_argument("--when")
    s.add_argument("--what")
    for n in ("done", "drop"):
        s = pp.add_parser(n)
        s.add_argument("id")
        if n == "done":
            s.add_argument("--note", default="")
    a, now = par.parse_args(), clock()
    if a.cmd == "promise":
        return promise_cmd(a, now)
    if a.cmd in ("answer", "did", "undo", "trust"):  # the state is the project's
        return trust_cmd(a, now)
    if a.cmd == "kind":
        print(kind_of(a.key, a.what))
    elif a.cmd == "scan":
        for l in promise_scan(project(a.cwd), now)[0]:
            print(l)
        for k, fp, summ in candidates(a.cwd):
            print(f"{k}\t{fp}\t{summ}")
    else:  # ask
        print(ask_level(a, kind_of(a.key, a.what), now))


if __name__ == "__main__":
    main()
