#!/usr/bin/env python3
"""next stop | scan [--cwd DIR] [--periodic] | ask KEY FP | asked KEY FP | status [--json]
        [--session ID]: find the next useful piece of work for /wanjang:next.

  stop    Stop hook (JSON on stdin). When /wanjang:next is on (a session cron whose prompt is
          `/wanjang:next check`) and the main agent just finished a piece of work, print
          additionalContext that asks it to run the check. Prints nothing otherwise; always exit 0.
  scan    print repository candidates not yet asked, one per line: key<TAB>fp<TAB>summary
          (uncommitted, todo, memory-next, run:<folder>). Never runs tests.
  ask     record that KEY with fingerprint FP was asked (idempotent); asked: exit 0 if recorded.
  status  last check age, last hook age, number asked.

State: ${CLAUDE_CONFIG_DIR:-~/.claude}/wanjang/next/<session>.json; session = --session, else
$CLAUDE_CODE_SESSION_ID (stop: session_id from the input).

Examples:
  next scan --periodic          # from the 30-minute cron; exit 3 if checked within 25 minutes
  next scan | cut -f1,3         # keys and summaries
  next ask uncommitted 3fa9c1d2 # hide that candidate until its fp changes
  next asked uncommitted 3fa9c1d2 && echo already asked

Exit codes: 0 ok, 1 not asked (asked), 2 bad arguments or no session, 3 periodic check skipped."""
import argparse, glob, hashlib, json, os, re, subprocess, sys, tempfile, time
from datetime import datetime

CRON = "/wanjang:next check"
TAIL, PERIOD, KEEP, ASKED_MAX, DAY7 = 300_000, 25 * 60, 7 * 86400, 50, 7 * 86400
LOOK = {"Read", "Grep", "Glob", "LS", "TaskList", "TaskGet", "ListAgents", "ToolSearch", "WebSearch",
        "WebFetch", "AskUserQuestion", "Skill", "CronCreate", "CronList", "CronDelete"}
TEXT = ("wanjang:next is on and you just finished a piece of work. Run the next-work check now: "
        "use the Skill tool with skill `wanjang:next` and args `check`. If your own work is still "
        "running or nothing is found, end your turn with no text.")


def sha(s):
    return hashlib.sha1(str(s).encode()).hexdigest()[:8]


def num(v):
    try:
        return float(v)
    except (TypeError, ValueError):
        return 0.0


def sdir():
    return os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "wanjang", "next")


def load(sid):
    try:
        d = json.load(open(os.path.join(sdir(), f"{sid}.json")))
        if not isinstance(d, dict):
            raise ValueError
    except (OSError, ValueError):
        d = {}
    if not isinstance(d.get("asked"), list):
        d["asked"] = []
    return d


def save(sid, d):
    d["asked"] = d["asked"][-ASKED_MAX:]
    p = sdir()
    try:
        os.makedirs(p, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=p, suffix=".tmp")
        with os.fdopen(fd, "w") as f:
            json.dump(d, f)
        os.replace(tmp, os.path.join(p, f"{sid}.json"))
    except OSError as e:
        print(f"next: cannot save state ({p}): {e}", file=sys.stderr)
        return
    me = f"{sid}.json"
    for f in glob.glob(p + "/*.json"):
        try:
            if os.path.basename(f) != me and time.time() - os.path.getmtime(f) > KEEP:
                os.remove(f)
        except OSError:
            pass


def ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def tail_rows(path):
    with open(path, "rb") as f:
        size = f.seek(0, 2)
        f.seek(max(0, size - TAIL))
        data = f.read()
    lines = data.split(b"\n")
    if size > TAIL:
        lines = lines[1:]  # first line is cut
    for l in lines:
        try:
            r = json.loads(l)
        except ValueError:
            continue
        if isinstance(r, dict) and not r.get("isSidechain"):
            yield r


def prompt_text(c):
    """text of a user prompt, or None when the entry is only tool results"""
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        bl = [b for b in c if isinstance(b, dict) and b.get("type") != "tool_result"]
        if bl:
            return " ".join(str(b.get("text", "")) for b in bl)
    return None


def stop_hook():
    try:
        inp = json.load(sys.stdin)
        if not isinstance(inp, dict):
            return
        if not any(isinstance(c, dict) and str(c.get("prompt", "")).strip() == CRON
                   for c in inp.get("session_crons") or []):
            return
        if inp.get("agent_id") or inp.get("stop_hook_active") is True:
            return
        if any(isinstance(t, dict) and str(t.get("status", "")).lower() in ("running", "pending")
               for t in inp.get("background_tasks") or []):
            return
        sid = str(inp.get("session_id") or "")
        if not sid or "/" in sid:
            return
        prompt = None  # (text, timestamp), tools used after it
        tools = set()
        for r in tail_rows(inp.get("transcript_path") or ""):
            m = r.get("message")
            if not isinstance(m, dict):
                continue
            if r.get("type") == "user":
                t = prompt_text(m.get("content"))
                if t is not None:
                    prompt, tools = (t, r.get("timestamp")), set()
            elif r.get("type") == "assistant" and isinstance(m.get("content"), list):
                tools |= {b.get("name") for b in m["content"] if isinstance(b, dict) and b.get("type") == "tool_use"}
        if not prompt or "wanjang:next" in prompt[0] or not (tools - LOOK):
            return
        d = load(sid)
        pt = ts(prompt[1]) if isinstance(prompt[1], str) else None
        if pt is None or num(d.get("last_hook")) >= pt:
            return
        d["last_hook"] = time.time()
        save(sid, d)
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "Stop", "additionalContext": TEXT}}))
    except Exception:
        pass


def git(cwd, *args):
    try:
        r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=15, errors="replace")
        return r.stdout if r.returncode == 0 else ""
    except Exception:
        return ""


def one(s, n=160):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def candidates(cwd):
    if not git(cwd, "rev-parse", "--git-dir").strip():
        return
    head = git(cwd, "rev-parse", "--short", "HEAD").strip()
    por = git(cwd, "status", "--porcelain")
    diff = git(cwd, "diff", "HEAD")
    if por.strip():
        files = [l[3:] for l in por.splitlines()]
        more = f" +{len(files) - 3} more" if len(files) > 3 else ""
        yield "uncommitted", sha(head + por + diff), one(f"{len(files)} files changed: {', '.join(files[:3])}{more}")
    todos, cur = [], ""
    for l in diff.splitlines():
        if l.startswith("+++ "):
            cur = l[6:] if l.startswith("+++ b/") else l[4:]
        elif l.startswith("+") and re.search(r"\b(TODO|FIXME|XXX)\b", l):
            todos.append(f"{cur}: {l[1:].strip()}")
    if todos:
        yield "todo", sha("\n".join(todos)), one(f"{len(todos)} new TODO/FIXME/XXX, first {todos[0]}")
    root = git(cwd, "rev-parse", "--show-toplevel").strip()
    try:
        lines = open(os.path.join(root, "MEMORY.md"), errors="replace").read().splitlines()
    except OSError:
        lines = []
    for i, l in enumerate(lines):
        h = re.match(r"(#+)\s+(.*)", l)
        if h and "next" in h.group(2).lower():
            body = []
            for l2 in lines[i + 1:]:
                h2 = re.match(r"(#+)\s", l2)
                if h2 and len(h2.group(1)) <= len(h.group(1)):
                    break
                body.append(l2)
            if "".join(body).strip():
                first = next(x for x in body if x.strip())
                yield "memory-next", sha("\n".join(body).strip()), one(f"MEMORY.md {h.group(2)}: {first.strip()}")
                break
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    for lp in sorted(glob.glob(f"{common}/wanjang/*/log.md")) if common else []:
        try:
            mt = os.path.getmtime(lp)
            txt = open(lp, errors="replace").read().splitlines()
        except OSError:
            continue
        if not txt or txt[0].strip() != "Status: in progress" or time.time() - mt > DAY7:
            continue
        name, goal = os.path.basename(os.path.dirname(lp)), ""
        for j, l in enumerate(txt):
            if l.lstrip("#* ").lower().startswith("goal"):
                goal = l.split(":", 1)[1].strip() if ":" in l else ""
                goal = goal or next((x.strip() for x in txt[j + 1:] if x.strip()), "")
                break
        yield f"run:{name}", sha(name + str(int(mt))), one(f"run in progress, goal: {goal}" if goal else "run in progress")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "stop":
        return stop_hook()
    par = argparse.ArgumentParser(prog="next", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    com = argparse.ArgumentParser(add_help=False)
    com.add_argument("--session", default=os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
    sub = par.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("scan", parents=[com])
    s.add_argument("--cwd", default=os.getcwd())
    s.add_argument("--periodic", action="store_true")
    for n in ("ask", "asked"):
        p = sub.add_parser(n, parents=[com])
        p.add_argument("key")
        p.add_argument("fp")
    s = sub.add_parser("status", parents=[com])
    s.add_argument("--json", action="store_true")
    a = par.parse_args()
    sid = a.session
    if not sid or "/" in sid:
        print("next: no session id (set --session or CLAUDE_CODE_SESSION_ID)", file=sys.stderr)
        sys.exit(2)
    d, now = load(sid), time.time()
    asked = {(x.get("key"), x.get("fp")) for x in d["asked"] if isinstance(x, dict)}
    if a.cmd == "scan":
        if a.periodic and now - num(d.get("last_check")) < PERIOD:
            sys.exit(3)
        d["last_check"] = now
        save(sid, d)
        for k, fp, summ in candidates(a.cwd):
            if (k, sha(fp)) not in asked:
                print(f"{k}\t{fp}\t{summ}")
    elif a.cmd == "ask":
        if (a.key, sha(a.fp)) not in asked:
            d["asked"].append({"key": a.key, "fp": sha(a.fp), "at": now})
            save(sid, d)
    elif a.cmd == "asked":
        sys.exit(0 if (a.key, sha(a.fp)) in asked else 1)
    else:
        age = lambda t: round(now - num(t)) if num(t) else None
        o = dict(last_check_age=age(d.get("last_check")), last_hook_age=age(d.get("last_hook")), asked=len(d["asked"]))
        if a.json:
            print(json.dumps(o))
        else:
            f = lambda v: "never" if v is None else f"{v}s ago"
            print(f"last check {f(o['last_check_age'])}, last hook {f(o['last_hook_age'])}, {o['asked']} asked")


main()
