#!/usr/bin/env bash
# UserPromptExpansion hook for /wanjang:provider: runs bin/provider itself and blocks the prompt,
# so switching works with no model call at all, even when the current provider can't answer
# (no OpenRouter credit, a bad key). `models` goes on to the skill: it needs the question flow.
set -u
input=$(cat)
[ "$(jq -r '.command_name // ""' <<<"$input")" = wanjang:provider ] || exit 0
read -ra args <<<"$(jq -r '.command_args // ""' <<<"$input")"  # split into words; never evaluated
case "${args[0]:-}" in models) exit 0 ;; esac
cwd=$(jq -r '.cwd // empty' <<<"$input")
out=$(cd "${cwd:-.}" && "$(dirname "$0")/provider" ${args[@]+"${args[@]}"} 2>&1 </dev/null); rc=$?
for a in ${args[@]+"${args[@]}"}; do [ "$a" = --user ] && out="Note: --user changed ~/.claude/settings.json, so every open session switched."$'\n'"$out"; done
[ $rc = 0 ] && out+=$'\n'"Check with /status: the \"Anthropic base URL\" line shows where requests go."
jq -n --arg r "$out" '{decision: "block", reason: $r, suppressOriginalPrompt: true}'
