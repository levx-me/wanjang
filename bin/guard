#!/usr/bin/env bash
# PreToolUse hook (Bash, Write, Edit) for the Foreman crew.
# - The foreman manages and never builds: it may write only into a run folder, and a Bash
#   call of its that would change files is refused with a pointer to its builder.
# - The read-only crew (planner, scout, checker, qa) write only their reports and scratch
#   files: into a run folder or a temp directory, never into the project.
# Writes into a temp directory (scratch notes, logs) stay allowed.
# ponytail: pattern match on the command line, so a determined write can slip past;
# it catches the usual ways (redirects, heredoc scripts, sed -i, tee, git commits).
set -u
input=$(cat)
type=$(printf '%s' "$input" | jq -r '.agent_type // empty')
case "$type" in
  foreman:foreman|foreman) role=foreman ;;
  foreman:planner|foreman:scout|foreman:checker|foreman:qa) role=reader ;;
  *) exit 0 ;;
esac

deny() { jq -n --arg r "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'; }

# Write and Edit: a run folder (briefs, reports, the run log), or for the read-only crew a temp dir.
case "$(printf '%s' "$input" | jq -r '.tool_name // empty')" in Write|Edit)
  file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty')
  case "$file" in
    */.git/foreman/*|"$HOME"/.claude/foreman/runs/*) ;;
    /tmp/*|/private/tmp/*|/var/folders/*|/private/var/folders/*) [ "$role" = reader ] || deny "The foreman writes only into its run folder (<git common dir>/foreman/<run>/). Send this change to foreman:builder or to the worker who owns that part." ;;
    *) if [ "$role" = foreman ]; then
         deny "The foreman writes only into its run folder (<git common dir>/foreman/<run>/). Send this change to foreman:builder or to the worker who owns that part."
       else
         deny "You are read-only on the project: write your report into the run folder your brief names (or a temp dir for scratch files), never into the repository."
       fi ;;
  esac
  exit 0 ;;
esac
[ "$role" = foreman ] || exit 0  # the read-only crew may run what it needs in Bash

cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // empty')

# Drop redirects that go nowhere or into temp dirs, then look for what is left.
probe=$(printf '%s' "$cmd" | sed -E \
  -e 's#[0-9]?>>?[[:space:]]*/dev/null##g' -e 's#[0-9]?>&[0-9]##g' \
  -e 's#>>?[[:space:]]*"?(/tmp|/private/tmp|/var/folders|\$TMPDIR|\$\{TMPDIR[^}]*\}|\$S|\$SP)[^[:space:];|&]*##g')
writes='(^|[^<>=-])>>?[[:space:]]*[^[:space:]&|=]|(^|[;&|[:space:]])(tee|truncate|install|patch)[[:space:]]|sed[[:space:]]+(-[a-zA-Z]*i|--in-place)|perl[[:space:]]+-[a-zA-Z]*i|(^|[;&|[:space:]])(rm|mv|cp|mkdir|touch|ln)[[:space:]]|git[[:space:]]+(-C[[:space:]]+[^[:space:]]+[[:space:]]+)?(commit|add|rm|mv|reset|checkout|restore|apply|am|merge|rebase|cherry-pick|stash|push|tag)|\.write_text|\.write\(|open\([^)]*["'"'"'][wa]\+?["'"'"']'

if printf '%s' "$probe" | grep -Eq "$writes"; then
  deny "The foreman does not change files itself. Send this change to foreman:builder (model haiku for a mechanical fix) or to the worker who owns that part. Bash is for looking: reading, running tests and builds, checking git state."
fi
exit 0
