#!/usr/bin/env bash
# SessionStart hook: puts the Foreman routing rule into every session's context, and a note
# about any Foreman run in this repository that stopped before it finished.
set -u
input=$(cat)
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
text=$(cat "$(dirname "$0")/../ROUTING.md")
if dir=$(git -C "${cwd:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  open=$(grep -l '^Status: in progress' "$dir"/foreman/*/log.md "$dir"/foreman/*.md 2>/dev/null)
  if [ -n "$open" ]; then
    text+=$'\n\nUnfinished Foreman runs in this repository (they stopped before reporting). Tell the user once, early, and offer `/foreman resume`; do not redo their work from scratch:\n'
    text+=$(printf '%s\n' "$open" | sed 's/^/- /')
  fi
fi
jq -n --arg t "$text" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $t}}'
