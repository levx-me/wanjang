#!/usr/bin/env bash
# SessionStart hook: puts the Wanjang routing rule into every session's context, and a note
# about any Wanjang run in this repository that stopped before it finished, any promise due here, and a
# /wanjang:manager that was on in this folder before a restart.
set -u
input=$(cat)
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
bin=$(cd "$(dirname "$0")" && pwd)
text=$(sed "s|<bin>|$bin|g" "$bin/../ROUTING.md")
if dir=$(git -C "${cwd:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  # Only logs touched in the last week: an older one was abandoned, not interrupted.
  open=$(find "$dir/wanjang" -maxdepth 2 -name '*.md' -mtime -7 2>/dev/null | xargs grep -l '^Status: in progress' 2>/dev/null)
  if [ -n "$open" ]; then
    text+=$'\n\nUnfinished Wanjang runs in this repository (they stopped before reporting). Resume the newest one right away: hand it to wanjang:pm in the background with \"Resume the run in <its folder>\", and tell the user in one line that it is carrying on. Ask first only if the first message from the user starts something that would clash with it. Never redo its work from scratch:\n'
    text+=$(printf '%s\n' "$open" | sed 's/^/- /')
  fi
fi
# Promises due in this project (read-only: runs no stored condition).
due=$("$bin/next" promise due --cwd "${cwd:-.}" 2>/dev/null)
[ -n "$due" ] && text+=$'\n\n'"$due"
# The manager was on in this folder and its session has ended (a restart): say how to resume it.
st=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/wanjang/manager/state.json
if [ -n "$cwd" ] && [ -f "$st" ] && IFS=$'\t' read -r on pid dir < <(jq -r '[.on, (.owner.pid // 0), (.owner.cwd // "")] | @tsv' "$st" 2>/dev/null) \
   && [ "$on" = true ] && [ "$dir" = "$cwd" ] && ! kill -0 "$pid" 2>/dev/null; then
  text+=$'\n\nmanager was on here; `/wanjang:manager on` to resume'
fi
jq -n --arg t "$text" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $t}}'
