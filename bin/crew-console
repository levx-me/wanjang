#!/usr/bin/env bash
# /wanjang:crew-console on [--budget USD] | off | status. State: ${CLAUDE_CONFIG_DIR:-~/.claude}/wanjang/crew-console.json
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
cfg=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/wanjang
f=$cfg/crew-console.json
cmd=${1:-status}; [ $# -gt 0 ] && shift
budget=$(jq -r '.budget // 10' "$f" 2>/dev/null || echo 10)
case $cmd in
  on)
    if [ "${1:-}" = --budget ]; then budget=${2:-}; fi
    printf '%s' "$budget" | grep -Eq '^[0-9]+(\.[0-9]+)?$' && [ -n "$(printf '%s' "$budget" | tr -d '0.')" ] || { echo "crew-console: --budget must be a positive number (USD)" >&2; exit 2; }
    "$root/bin/console-key" >/dev/null 2>&1 || { echo "crew-console: no Console key stored; run /wanjang:provider key console first" >&2; exit 3; }
    mkdir -p "$cfg" && jq -n --argjson b "$budget" '{on:true,budget:$b}' > "$f"
    echo "crew-console: on, budget \$$budget per run. wanjang agents now run as separate API-billed sessions." ;;
  off)
    mkdir -p "$cfg" && jq -n --argjson b "$budget" '{on:false,budget:$b}' > "$f"
    echo "crew-console: off. wanjang agents use the session's own login again." ;;
  status)
    [ "$(jq -r '.on // false' "$f" 2>/dev/null)" = true ] && s=on || s=off
    echo "crew-console: $s, budget \$$budget per run"
    ls -t "$cfg"/crew-console/*.json 2>/dev/null | head -5 | while IFS= read -r l; do
      jq -r --arg n "$(basename "$l")" 'if type=="array" then (map(select(.type=="result"))|last // {}) else . end | "  \($n): $\(.total_cost_usd // 0)"' "$l" 2>/dev/null
    done ;;
  *) echo "usage: crew-console on [--budget USD] | off | status" >&2; exit 2 ;;
esac
