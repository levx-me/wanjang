#!/usr/bin/env python3
"""status [--session ID|PATH] [--cwd DIR] [--json] [--eta] [--bars]: a compact snapshot of what this Claude Code
session's agents are doing now, read from transcripts on disk (only the last 200 KB of each).

  agents  subagents (and crew-api runs: tagged [api], `"api": true`) written to in the last 2 hours, nested under their parent: type, task, age,
          running or finished, last tool call, a tool call still waiting for its result, last text
  stuck   running, silent for over 10 minutes and not waiting on a tool result
  runs    Wanjang run folders touched in the last 2 hours: status line and last 5 log lines
  tasks   the main session's open tasks, if on disk
  --eta   when each running agent should finish, from how long past finished agents of the same
          type and model took, counting only those that lasted longer than this agent has run (median =
          likely, 80th percentile = latest; needs 5 samples and 3 longer, else the type alone, else
          no estimate). A finished agent with a running descendant is [WAITING] (--json:
          waits_on_children) and is estimated too. A wanjang:pm with a `## Tasks` table in its run log is
          refined by that table (k of n done, running and todo rows). Ends with when all top-level
          running work should be done. In --json each agent gets eta {likely, latest, left_min,
          basis_n, basis, over} (epoch seconds, null when none) and the top level eta_all.
          A worker that keeps a step list (TaskCreate with a "[tag] " subject prefix: read, plan, edit, test, review, docs,
          report; TaskUpdate to mark progress) is estimated from its steps: the current step's rest plus the median of each
          step to come, from every finished step on disk (the steps table of that database; type and model, else tag alone), scaled by this
          agent's pace on its finished steps (method "progress"). With no list, its tool calls give a stage (only reads, edits
          begun, a test or build after the last edit) blended with the history median (method "phase"); else
          method "history". --json adds eta.method and steps_done, steps_total. A step's change re-estimates, like a Tasks count.
          Each agent's first estimate is held in the eta_held table until its likely time passes or its PM's Tasks counts or its steps' counts change.
          History is cached in the eta_cache table of ${CLAUDE_CONFIG_DIR:-~/.claude}/wanjang/wanjang.db (rebuilt after 10 min or when an
          agent meta file is newer). --bars (implies --eta) prints a bar per agent, elapsed / likely total, with
          neutral English labels.
          Clock: env WANJANG_NOW (epoch seconds) replaces the current time, for tests.

Session: --session, else $CLAUDE_CODE_SESSION_ID, else the newest transcript for the cwd.
Exit codes: 0 snapshot printed, 2 bad arguments or no transcript."""
import argparse, glob, json, os, re, sqlite3, statistics, subprocess, sys, time
from datetime import datetime

TAIL, WINDOW, STUCK = 200_000, 7200, 600
ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
ap.add_argument("--session", default=os.environ.get("CLAUDE_CODE_SESSION_ID", ""))
ap.add_argument("--cwd", default=os.getcwd())
ap.add_argument("--json", action="store_true")
ap.add_argument("--eta", action="store_true")
ap.add_argument("--bars", action="store_true")
a = ap.parse_args()
a.eta = a.eta or a.bars
home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
try:
    now = float(os.environ.get("WANJANG_NOW") or time.time())
except ValueError:  # not a number: the real clock
    now = time.time()

# --- find the session transcript
how, main = "", ""
if a.session and os.path.isfile(a.session):
    main, how = a.session, "path given"
elif a.session:
    f = glob.glob(f"{home}/projects/*/{a.session}.jsonl")
    if f:
        main, how = max(f, key=os.path.getmtime), "session id"
if not main and not a.session:
    slug = a.cwd.replace("/", "-").replace(".", "-")
    f = glob.glob(f"{home}/projects/{slug}/*.jsonl")
    if f:
        main, how = max(f, key=os.path.getmtime), "newest transcript for this cwd (no session id)"
if not main:
    print(f"status: no transcript for session {a.session or a.cwd}", file=sys.stderr)
    sys.exit(2)
sid = os.path.basename(main)[:-6]


def ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def tail_rows(path, tail=TAIL):
    with open(path, "rb") as f:
        size = f.seek(0, 2)
        f.seek(max(0, size - tail))
        data = f.read()
    lines = data.split(b"\n")
    if size > tail:
        lines = lines[1:]  # first line is cut
    for l in lines:
        try:
            yield json.loads(l)
        except ValueError:
            pass


def first_ts(path):
    with open(path, "rb") as f:
        for _ in range(5):
            try:
                t = ts(json.loads(f.readline(65536)).get("timestamp", ""))
            except ValueError:
                continue
            if t:
                return t
    return None


def short(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def brief(inp):
    for k in ("command", "file_path", "path", "pattern", "description", "url", "query", "prompt"):
        if isinstance(inp, dict) and inp.get(k):
            return short(inp[k], 70)
    return ""


def digest(path):
    """last tool call, calls still waiting, last text, last record time, last record is a final reply"""
    uses, done, last_tool, text, last, final = {}, set(), None, "", None, False
    for r in tail_rows(path):
        t = ts(r.get("timestamp", "")) if r.get("timestamp") else None
        m = r.get("message")
        if not isinstance(m, dict) or r.get("type") not in ("assistant", "user"):
            continue
        if t:
            last = t
        c = m.get("content")
        if not isinstance(c, list):
            continue
        if r["type"] == "assistant":
            final = True
            for b in c:
                if b.get("type") == "tool_use":
                    final = False
                    uses[b["id"]] = (b["name"], brief(b.get("input")), t)
                    last_tool = b["id"]
                elif b.get("type") == "text" and b.get("text", "").strip():
                    text = b["text"].strip().splitlines()[-1]
        else:
            final = False
            for b in c:
                if b.get("type") == "tool_result":
                    done.add(b.get("tool_use_id"))
    waiting = [(n, d, t) for i, (n, d, t) in uses.items() if i not in done]
    lt = uses.get(last_tool)
    return dict(last_tool=lt, waiting=waiting, text=short(text, 120), last=last, final=final)


# --- agents
agents, models = [], {}


def add_agents(base, root=None):
    """subagents under <base>/subagents; for a crew-api child they hang under its run entry `root`"""
    for mp in glob.glob(f"{base}/subagents/agent-*.meta.json"):
        jp = mp[: -len(".meta.json")] + ".jsonl"
        try:
            mt = os.path.getmtime(jp)
            if now - mt > WINDOW:
                continue
            meta = json.load(open(mp))
            d = digest(jp)
        except (OSError, ValueError):
            continue
        aid = os.path.basename(jp)[6:-6]
        last = d["last"] or mt
        running = not (meta.get("finished") or d["final"])
        w = d["waiting"][0] if d["waiting"] and running else None
        depth = meta.get("spawnDepth", 1) + bool(root)
        ag = dict(id=aid, type=meta.get("agentType", "?"), desc=meta.get("description", ""),
                  depth=depth, parent=meta.get("parentAgentId") or (root if depth == 2 else None),
                  started=first_ts(jp) or mt, last_write=mt, running=running, api=False, died=False, jp=jp,
                  last_tool=d["last_tool"] and f"{d['last_tool'][0]} {d['last_tool'][1]}".strip(),
                  waiting=w and dict(tool=w[0], what=w[1], secs=int(now - (w[2] or last))),
                  text=d["text"], stuck=False)
        models[aid] = None if meta.get("model") in (None, "inherit") else meta["model"]
        ag["stuck"] = running and not w and now - mt > STUCK
        agents.append(ag)


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except PermissionError:
        return True
    except (OSError, ValueError, TypeError):
        return False


CREW_COLS = "session_id parent_session_id agent model effort title cwd pid started status cost_usd exit ended log".split()


def crew_records():
    """crew-api run records (crew_runs table), as (record dict, epoch seconds it was last written)"""
    db = open_db()
    try:
        for *v, upd in db.execute(f"SELECT {', '.join(CREW_COLS)}, updated FROM crew_runs"):
            yield dict(zip(CREW_COLS, v)), upd or 0
    except (sqlite3.Error, AttributeError):
        pass


_db = []


def open_db():
    """the wanjang database (WAL, 5 s busy timeout; bin/schema.sql), or None when it cannot be opened; opened once. The first
    open imports the old eta-cache.json and eta-held.json and renames them *.migrated (never deleted), and the runs/*.json
    records into crew_runs (those stay where they are: bin/crew-run still writes them and a consumer such as the deck reads them)"""
    if _db:
        return _db[0]
    _db.append(None)
    try:
        os.makedirs(f"{home}/wanjang", exist_ok=True)
        db = sqlite3.connect(f"{home}/wanjang/wanjang.db", timeout=5)
        db.execute("PRAGMA journal_mode=WAL")
        db.executescript(open(os.path.join(os.path.dirname(os.path.realpath(__file__)), "schema.sql")).read())
        for name, sql, rows in (
                ("eta-cache.json", "INSERT INTO eta_cache VALUES(?,?,?,?)",
                 lambda j, built: [(t, m, v, built) for t, m, vs in j["hist"] for v in vs]),
                ("eta-held.json", "INSERT OR REPLACE INTO eta_held VALUES(?,?,?,?,?)",
                 lambda j, built: [(i, h.get("likely"), json.dumps(h.get("key")), h.get("seen"), json.dumps(h.get("e")))
                                   for i, h in j.items() if isinstance(h, dict)])):
            f = f"{home}/wanjang/{name}"
            if os.path.exists(f):
                try:
                    with db:
                        db.executemany(sql, rows(json.load(open(f)), os.path.getmtime(f)))
                except (ValueError, KeyError, TypeError, AttributeError):
                    pass  # unreadable old file: renamed all the same, it was only a cache
                os.replace(f, f + ".migrated")
        if not db.execute("SELECT 1 FROM meta WHERE key='crew_runs_imported'").fetchone():
            with db:
                for n in ("crew-console", "crew-api"):  # the old name first: a run in both folders keeps the newer
                    for rp in glob.glob(f"{home}/wanjang/{n}/runs/*.json"):
                        try:
                            r = json.load(open(rp))
                            db.execute(f"INSERT OR REPLACE INTO crew_runs VALUES({','.join('?' * (len(CREW_COLS) + 1))})",
                                       [r.get(c) for c in CREW_COLS] + [os.path.getmtime(rp)])
                        except (OSError, ValueError, AttributeError, sqlite3.Error):
                            pass
                db.execute("INSERT INTO meta VALUES('crew_runs_imported', '1')")
        _db[0] = db
        return db
    except (sqlite3.Error, OSError):
        return None


add_agents(os.path.splitext(main)[0])
for rec, _ in crew_records():  # crew-api runs of this session: separate `claude -p` sessions, agents like subagents
    if rec.get("parent_session_id") != sid or not rec.get("session_id"):
        continue
    rid = rec["session_id"]
    f = glob.glob(f"{home}/projects/*/{rid}.jsonl")
    if not f or any(g["id"] == rid for g in agents):
        continue
    jp = f[0]
    try:
        mt = os.path.getmtime(jp)
        if now - mt > WINDOW:
            continue
        d = digest(jp)
    except OSError:
        continue
    up = rec.get("status") == "running" and (alive(rec.get("pid")) or now - mt <= STUCK)
    w = d["waiting"][0] if d["waiting"] and up else None
    agents.append(dict(id=rid, type="wanjang:" + str(rec.get("agent") or "?"), desc=rec.get("title", ""), depth=1,
                       parent=None, started=rec.get("started") or first_ts(jp) or mt, last_write=mt, running=up,
                       api=True, jp=jp, died=rec.get("status") == "running" and not up,
                       last_tool=d["last_tool"] and f"{d['last_tool'][0]} {d['last_tool'][1]}".strip(),
                       waiting=w and dict(tool=w[0], what=w[1], secs=int(now - (w[2] or d["last"] or mt))),
                       text=d["text"], stuck=bool(up and not w and now - mt > STUCK)))
    models[rid] = rec.get("model")
    add_agents(os.path.splitext(jp)[0], rid)
agents.sort(key=lambda g: g["started"])
byid = {g["id"]: g for g in agents}
for g in agents:  # no recorded parent: nearest earlier agent one level up
    if not g["parent"] and g["depth"] > 1:
        c = [p for p in agents if p["depth"] == g["depth"] - 1 and p["started"] <= g["started"]]
        g["parent"] = c[-1]["id"] if c else None


def order(pid=None):
    for g in agents:
        if (g["parent"] if g["parent"] in byid else None) == pid:
            yield g
            yield from order(g["id"])


tree = list(order())
for g in agents:  # a finished agent with a running descendant is waiting for it (a PM waits for hand-backs with its turn ended)
    g["waits_on_children"] = False
for g in agents:
    p = byid.get(g["parent"])
    while g["running"] and p and p["id"] != g["id"]:
        p["waits_on_children"] = p["waits_on_children"] or not p["running"]
        p = byid.get(p["parent"])
active = lambda g: g["running"] or g["waits_on_children"]

# --- wanjang runs
cwd = a.cwd
for r in tail_rows(main):
    if r.get("cwd"):
        cwd = r["cwd"]
dirs = [os.path.expanduser("~/.claude/wanjang/runs")]
try:
    g = subprocess.run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                       capture_output=True, text=True, timeout=5).stdout.strip()
    if g:
        dirs.append(g + "/wanjang")
except Exception:
    pass
runs, rlogs = [], []
for d in dirs:
    for lp in glob.glob(f"{d}/*/log.md"):
        try:
            mt = os.path.getmtime(lp)
            if now - mt > WINDOW:
                continue
            with open(lp, errors="replace") as f:
                first = f.readline().strip()
            lines = [l for l in open(lp, errors="replace").read().splitlines()[-40:] if l.strip()][-5:]
        except OSError:
            continue
        rlogs.append((mt, lp))
        runs.append(dict(run=os.path.basename(os.path.dirname(lp)), status=first, updated=mt,
                         tail=[short(l, 110) for l in lines]))
runs.sort(key=lambda r: -r["updated"])

# --- tasks
tasks = []
for tp in glob.glob(f"{home}/tasks/session-{sid[:8]}/*.json"):
    try:
        t = json.load(open(tp))
        if t.get("status") != "completed":
            tasks.append(dict(id=t.get("id"), status=t.get("status"), subject=short(t.get("subject", ""), 80)))
    except (OSError, ValueError):
        pass
tasks.sort(key=lambda t: (str(t["id"]).zfill(6)))

# --- eta
eta, eta_all, no_eta, tasks_of = {}, None, 0, {}
if a.eta:
    db = open_db()
    hist = {}
    metas = glob.glob(f"{home}/projects/*/*/subagents/agent-*.meta.json")
    try:  # warm: under 10 min old and no meta file written since (one stat each)
        cm = db.execute("SELECT max(built) FROM eta_cache").fetchone()[0] or 0
        if now - cm < 600 and max([os.path.getmtime(m) for m in metas] + [u for _, u in crew_records()], default=0) <= cm:
            for t, m, v in db.execute("SELECT agent_type, model, minutes FROM eta_cache"):
                hist.setdefault((t, m), []).append(v)
    except (sqlite3.Error, AttributeError, OSError):
        hist = {}
    warm = bool(hist)
    for mp in () if warm else metas:
        try:
            m = json.load(open(mp))
            if not m.get("finished"):
                continue
            jp = mp[: -len(".meta.json")] + ".jsonl"
            t0 = first_ts(jp)
            t1 = max((t for t in (ts(r.get("timestamp", "")) for r in tail_rows(jp, 20_000)
                                  if isinstance(r.get("timestamp"), str)) if t), default=None)
        except (OSError, ValueError, AttributeError):
            continue
        if t0 and t1 and t1 > t0:
            mod = None if m.get("model") == "inherit" else m.get("model")
            for k in ((m.get("agentType"), mod), (m.get("agentType"), "*")):
                hist.setdefault(k, []).append((t1 - t0) / 60)
    for rec, _ in () if warm else crew_records():  # finished crew-api runs count like finished subagents
        if rec.get("status") == "done" and rec.get("ended") and rec.get("started") and rec["ended"] > rec["started"]:
            for k in ((f"wanjang:{rec.get('agent')}", rec.get("model")), (f"wanjang:{rec.get('agent')}", "*")):
                hist.setdefault(k, []).append((rec["ended"] - rec["started"]) / 60)
    if hist and not warm and db:
        try:  # a failed write only costs the next call a rebuild
            with db:
                db.execute("DELETE FROM eta_cache")
                db.executemany("INSERT INTO eta_cache VALUES(?,?,?,?)",
                               [(t, m, v, time.time()) for (t, m), vs in hist.items() for v in vs])
        except sqlite3.Error:
            pass

    TAGS = "read|plan|edit|test|review|docs|report"

    def scan(jp, tools=False):
        """an agent's own steps from its TaskCreate/TaskUpdate calls (the only step record transcripts have; TodoWrite never
        appears in them, in subscription or `claude -p` runs): steps [{tag, start, end}] in creation order, tagged ("[edit] ...")
        ones only, last_end (the last completion of any task, else the start), and with tools=True the tool calls [(name, command)]"""
        made, tasks, order, tl = {}, {}, [], []
        last = first_ts(jp)
        with open(jp, "rb") as f:
            for l in f:
                if not (tools or b"TaskCreate" in l or b"TaskUpdate" in l or b"Task #" in l):
                    continue
                try:
                    r = json.loads(l)
                except ValueError:
                    continue
                t, c = ts(r.get("timestamp") or ""), (r.get("message") or {}).get("content")
                for b in c if isinstance(c, list) else ():
                    if not isinstance(b, dict) or not t:
                        continue
                    i = b.get("input") if isinstance(b.get("input"), dict) else {}
                    if b.get("type") == "tool_use" and b.get("name") == "TaskCreate":
                        made[b.get("id")] = str(i.get("subject", ""))
                    elif b.get("type") == "tool_use" and b.get("name") == "TaskUpdate":
                        k = tasks.get(str(i.get("taskId")))
                        if not k:
                            continue
                        k["subject"] = str(i.get("subject", k["subject"]))
                        if i.get("status") == "in_progress" and not k["start"]:
                            k["start"] = t
                        elif i.get("status") == "completed" and not k["end"]:
                            k["start"], k["end"], last = k["start"] or last, t, t
                        elif i.get("status") == "deleted":
                            k["gone"] = True
                    elif b.get("type") == "tool_use":
                        tl.append((b.get("name", ""), str(i.get("command", ""))))
                    elif b.get("type") == "tool_result" and b.get("tool_use_id") in made:
                        x = b.get("content")
                        x = x if isinstance(x, str) else " ".join(str(y.get("text", "")) for y in x if isinstance(y, dict)) if isinstance(x, list) else ""
                        m = re.match(r"Task #(\d+) created", x)
                        if m:
                            tasks[m.group(1)] = dict(subject=made[b["tool_use_id"]], start=None, end=None, gone=False)
                            order.append(tasks[m.group(1)])
        steps = []
        for k in order:
            m = re.match(rf"\[({TAGS})\]", k["subject"].strip().lower())
            if m and not k["gone"]:
                steps.append(dict(tag=m.group(1), start=k["start"], end=k["end"]))
        return dict(steps=steps, last_end=last, tools=tl)

    # step history: every finished step of every agent on disk (type, model, tag, minutes, start, end), in the steps table
    # derived from the transcripts; a transcript is rescanned only when its mtime or size changed, and only new steps are inserted
    try:
        seen = {p: (m, z) for p, m, z in db.execute("SELECT path, mtime, size FROM transcripts")}
        cand = {mp[: -len(".meta.json")] + ".jsonl": (mp, None) for mp in metas}
        for rec, _ in crew_records():
            for jp in glob.glob(f"{home}/projects/*/{rec['session_id']}.jsonl") if rec.get("session_id") else ():
                cand[jp] = (None, rec)
        for jp, (mp, rec) in cand.items():
            try:
                stt = os.stat(jp)
                if seen.get(jp) == (stt.st_mtime, stt.st_size):
                    continue
                if mp:
                    m = json.load(open(mp))
                    typ, mod = m.get("agentType"), None if m.get("model") == "inherit" else m.get("model")
                else:
                    typ, mod = f"wanjang:{rec.get('agent')}", rec.get("model")
                have = set(db.execute("SELECT t0, t1 FROM steps WHERE path=?", (jp,)))
                # ponytail: a batch "mark all done" at the end gives near-zero durations; steps under 10 s are dropped, not repaired
                rows = [(jp, typ, mod, s["tag"], (s["end"] - s["start"]) / 60, s["start"], s["end"]) for s in scan(jp)["steps"]
                        if s["end"] and s["start"] and s["end"] - s["start"] >= 10 and (s["start"], s["end"]) not in have]
            except (OSError, ValueError, AttributeError):
                continue
            if rows or jp not in seen:  # a running agent with nothing new costs no write
                db.executemany("INSERT INTO steps VALUES(?,?,?,?,?,?,?)", rows)
                db.execute("INSERT OR REPLACE INTO transcripts VALUES(?,?,?)", (jp, stt.st_mtime, stt.st_size))
        db.commit()
    except (sqlite3.Error, AttributeError):
        db = None  # no step history this call: the estimate falls back to the phase and agent history

    def step_stat(typ, model, tag, own):
        """(median min, p80 min, n) of the other agents' finished steps with this tag, for the type and model, else for
        the tag alone; needs 3. None when there are fewer"""
        if not db:
            return None
        try:
            for q, args in (("agent_type IS ? AND model IS ? AND tag=?", (typ, model, tag)), ("tag=?", (tag,))):
                v = [r[0] for r in db.execute(f"SELECT minutes FROM steps WHERE {q} AND path<>? ORDER BY minutes", args + (own,))]
                if len(v) >= 3:
                    return statistics.median(v), v[min(len(v) - 1, int(0.8 * len(v)))], len(v)
        except sqlite3.Error:
            pass
        return None

    def stat(typ, model, el=0):
        """(median min, p80 min, n, basis, n of group) of the past samples that lasted longer than el minutes, for the
        model group, else the type alone; needs 5 in the group and 3 longer. Else (None, p80 of the group, ...) when
        the agent ran past them, else None"""
        groups = [(sorted(hist.get(k, ())), label) for k, label in
                  (((typ, model), f"{typ} {model}" if model else typ), ((typ, "*"), typ))]
        for v, label in groups:
            w = [x for x in v if x > el]
            if len(v) >= 5 and len(w) >= 3:
                return statistics.median(w), w[min(len(w) - 1, int(0.8 * len(w)))], len(w), label, len(v)
        return next(((None, v[min(len(v) - 1, int(0.8 * len(v)))], len(v), label, len(v)) for v, label in groups if len(v) >= 5), None)

    def worker(cell):
        """'builder opus' -> ('wanjang:builder', 'opus'); unknown -> builder sonnet"""
        w = cell.lower().split()
        typ = next((x for x in w if x in ("builder", "qa", "checker", "scout", "planner", "pm")), "builder")
        return "wanjang:" + typ, next((x for x in w if x in ("opus", "sonnet", "haiku")), "sonnet")

    def table(lp):
        """rows of the run log's `## Tasks` table as dicts keyed by lowercase header"""
        rows, head, on = [], None, False
        for l in open(lp, errors="replace").read().splitlines():
            if l.startswith("#"):
                on = l.strip().lower() == "## tasks"
            elif on and l.startswith("|"):
                c = [x.strip() for x in l.strip().strip("|").split("|")]
                if head is None:
                    head = [x.lower() for x in c]
                elif not set("".join(c)) <= set("-: "):
                    rows.append(dict(zip(head, c), _line=l))
        return rows

    def own_log(g):
        """the run log this PM named last in its tool_use inputs (`wanjang/<run>/log.md` in a repository, `wanjang/runs/<run>/log.md` outside one), as an rlogs path"""
        found = None
        try:
            for r in tail_rows(g["jp"]):
                c = (r.get("message") or {}).get("content")
                for b in c if isinstance(c, list) else ():
                    i = b.get("input") if isinstance(b, dict) and b.get("type") == "tool_use" else None
                    if isinstance(i, dict):
                        m = re.findall(r"wanjang/(?:runs/)?[^/\s\"']+/log\.md", f"{i.get('file_path', '')} {i.get('command', '')}")
                        found = m[-1] if m else found
        except OSError:
            pass
        return next((lp for _, lp in rlogs if found and lp.endswith("/" + found)), None)

    def progress(g, sc):
        """by the agent's own steps: the current step's expected rest plus the median of every step still to come (this type
        and model's past steps with the same tag, else any agent's), all scaled by how fast this agent ran its finished steps
        against those medians. (likely, latest, n, done, total) or None when it has no steps, none left, or a tag has no history"""
        steps = sc["steps"]
        todo = [s for s in steps if not s["end"]]
        if not todo:
            return None
        ms = {t: step_stat(g["type"], models.get(g["id"]), t, g["jp"]) for t in {s["tag"] for s in steps}}
        if any(ms[s["tag"]] is None for s in todo):
            return None
        own = [((s["end"] - s["start"]) / 60, ms[s["tag"]][0]) for s in steps if s["end"] and s["start"] and ms[s["tag"]]]
        k = min(4, max(0.25, sum(x for x, _ in own) / sum(y for _, y in own))) if own else 1
        cur = next((s for s in todo if s["start"]), todo[0])
        el = max(0, now - (cur["start"] or sc["last_end"] or now)) / 60
        out = []
        for i in (0, 1):  # median, then p80
            c = ms[cur["tag"]][i] * k
            # ponytail: a step past its expected length is guessed to need half as long again as it has run; no data behind it
            out.append(now + 60 * (c - el if el < c else el / 2) + 60 * sum(ms[s["tag"]][i] * k for s in todo if s is not cur))
        return out[0], max(out), min(ms[s["tag"]][2] for s in todo), len(steps) - len(todo), len(steps)

    def phase(tools):
        """what stage a step-less agent is in, from its tool calls: (name, fraction of the run done) or None under 3 calls.
        Only reads so far: early; edits or writes begun: middle; a test or build command after the last edit: late"""
        if len(tools) < 3:
            return None
        last = max((i for i, (n, _) in enumerate(tools) if n in ("Edit", "Write", "MultiEdit", "NotebookEdit")), default=None)
        if last is None:
            return "early", 0.25
        if any(n == "Bash" and re.search(r"\b(test|tests|pytest|jest|vitest|cargo|npm|bun|make|build|tsc|lint|check|forge)\b", c)
               for n, c in tools[last:]):
            return "late", 0.85
        return "middle", 0.55

    held = {}  # each agent's first estimate, kept until it passes (else the countdown climbs)
    try:
        for i, lk, k, sn, ej in db.execute("SELECT agent_id, likely, key, seen, e FROM eta_held"):
            held[i] = dict(likely=lk, key=json.loads(k), seen=sn, e=json.loads(ej))
    except (sqlite3.Error, AttributeError, ValueError):
        held = {}
    held0 = json.dumps(held, sort_keys=True)
    p80s = {}
    def below(g):
        for x in agents:
            if x["parent"] == g["id"]:
                yield x
                yield from below(x)

    for g in sorted(tree, key=lambda g: (g["type"] == "wanjang:pm", -g["depth"])):  # workers first, PMs last: rows read their workers' eta
        if not active(g):
            continue
        st = stat(g["type"], models.get(g["id"]), (now - g["started"]) / 60)
        e = dict(likely=None, latest=None, left_min=None, basis_n=None, basis=None, over=False, method=None)
        key = None  # a PM's Tasks counts: a change is real news and re-estimates
        if st:
            med, p80, e["basis_n"], e["basis"], e["basis_of"] = st
            if med is not None and e["basis_n"] != e["basis_of"]:
                e["basis"] += " that ran this long"
            p80s[g["id"]] = p80
            if med is None:
                e["over"] = True
            else:
                e["likely"], e["latest"] = g["started"] + med * 60, g["started"] + p80 * 60
        e["method"] = "history" if e["likely"] or e["over"] else None
        if g["type"] != "wanjang:pm":
            try:
                sc = scan(g["jp"], tools=True)
                pr = progress(g, sc)
                ph = None if pr else phase(sc["tools"])
            except OSError:
                pr = ph = None
            if pr:
                e["likely"], e["latest"], e["basis_n"], e["steps_done"], e["steps_total"] = pr
                e.update(method="progress", over=False, basis=f"progress: {pr[3]} of {pr[4]} steps done", basis_of=None)
                key = [pr[3], pr[4]]
            elif ph and st and st[0] is not None:  # blended with the history median; needs one, else the run log or none
                el = now - g["started"]
                e["likely"] = g["started"] + (el / ph[1] + st[0] * 60) / 2
                e["latest"] = e["likely"] + (st[1] - st[0]) * 60
                e.update(method="phase", over=False, basis=f"phase: {ph[0]}, blended with {e['basis']}", basis_n=None, basis_of=None)
                key = [ph[0]]
        dl = max((eta[x["id"]]["likely"] for x in below(g) if x["id"] in eta and eta[x["id"]]["likely"]), default=None)
        if g["waits_on_children"] and dl:
            e["likely"] = max(e["likely"] or 0, dl)
            e["latest"] = max(e["latest"] or 0, e["likely"])
            e["over"] = False
        if g["type"] == "wanjang:pm" and rlogs:
            try:
                # the PM's own run log; ponytail: none named in its transcript tail -> the newest run log with a
                # Tasks table, which two such PMs would share
                own = own_log(g)
                rows = (own and table(own)) or next(r for r in (table(lp) for _, lp in sorted(rlogs, reverse=True)) if r)
            except (StopIteration, OSError):
                rows = []
            if rows:
                first = lambda r: (r.get("status", "").lower().split() or [""])[0]  # "done f71b50a; 1.77s" counts as done
                done = sum(first(r) == "done" for r in rows)
                left, todo = [], 0
                for r in rows:
                    s = first(r)
                    if s not in ("running", "todo"):
                        continue
                    ws = stat(*worker(r.get("worker", ""))) or stat("wanjang:builder", "sonnet")
                    mine = [x for x in tree if x["running"] and x["id"] != g["id"] and x["id"] in eta
                            and re.search(rf"\b{re.escape(x['id'])}\b", r["_line"])]
                    if s == "running" and mine and eta[mine[0]["id"]]["likely"]:
                        left.append(max(0, eta[mine[0]["id"]]["likely"] - now) / 60)
                    elif s == "running":
                        left.append(ws[0] if ws else 0)
                    else:
                        todo += ws[0] if ws else 0
                end = now + (max(left, default=0) + todo) * 60
                e["likely"] = max(e["likely"] or 0, end)
                e["latest"] = max(e["latest"] or 0, e["likely"])
                e["over"] = False
                e["basis"] = f"{e['basis'] or 'run log'}; {done} of {len(rows)} tasks done"
                e["tasks_done"], e["tasks_total"] = done, len(rows)
                key = [done, len(rows), sum(first(r) == "running" for r in rows)]
        if e["likely"]:
            e["left_min"] = max(0, round((e["likely"] - now) / 60))
        if e["over"] or g["stuck"]:
            e["likely"] = e["latest"] = e["left_min"] = None
        h = held.get(g["id"])
        if g["stuck"]:
            held.pop(g["id"], None)
        elif h and h.get("likely") and now < h["likely"] and h.get("key") == key:
            for k in ("likely", "latest", "basis", "basis_n", "basis_of", "over", "method", "tasks_done", "tasks_total", "steps_done", "steps_total"):
                if k in h["e"]:
                    e[k] = h["e"][k]
            e["left_min"] = max(0, round((e["likely"] - now) / 60))
            h["seen"] = now
        elif e["likely"]:
            held[g["id"]] = dict(likely=e["likely"], key=key, seen=now, e={k: e[k] for k in e if k != "left_min"})
        else:
            held.pop(g["id"], None)
        eta[g["id"]] = e
    held = {i: h for i, h in held.items() if isinstance(h, dict) and now - h.get("seen", 0) < 86400}
    if db and json.dumps(held, sort_keys=True) != held0:
        try:  # a deck and a wen may call at once: one transaction, the busy timeout waits for the other
            with db:
                db.execute("DELETE FROM eta_held")
                db.executemany("INSERT INTO eta_held VALUES(?,?,?,?,?)", [(i, h.get("likely"), json.dumps(h.get("key")), h.get("seen"),
                                                                       json.dumps(h.get("e"))) for i, h in held.items()])
        except sqlite3.Error:
            pass
    roots = [eta[g["id"]]["likely"] for g in tree
             if active(g) and not (g["parent"] in byid and active(byid[g["parent"]]))]
    top = [t for t in roots if t]
    eta_all, no_eta = max(top, default=None), len(roots) - len(top)
    for g in tree:
        g["eta"] = eta.get(g["id"])

if a.json:
    out = dict(session=sid, transcript=main, found_by=how, agents=tree, runs=runs, tasks=tasks)
    if a.eta:
        out["eta_all"] = eta_all
    print(json.dumps(out, indent=1))
    sys.exit(0)


def ago(t):
    s = int(now - t)
    return f"{s}s" if s < 90 else f"{s // 60}m" if s < 5400 else f"{s // 3600}h{s % 3600 // 60:02d}m"


L = [f"session {sid[:8]} ({how})"]
n_run = sum(g["running"] for g in tree)
L.append(f"agents: {n_run} running, {len(tree) - n_run} finished in the last 2h")


def clock(t):
    d = datetime.fromtimestamp(t)
    return d.strftime("%H:%M" if d.date() == datetime.fromtimestamp(now).date() else "%m-%d %H:%M")


if a.bars:
    W, rows = 14, []
    for g in tree:
        e = g["eta"]
        if not e:
            continue
        lab = "  " * (g["depth"] - 1 if g["parent"] in byid else 0) + short(g["desc"], 14)
        if g["stuck"]:
            bar, note = "?" * W, "may be stuck"
        elif e["over"]:
            bar, note = "\u2588" * (W - 1) + "\u2592", "longer than usual"
        elif not e["likely"]:
            bar, note = "\u2591" * W, "no estimate"
        else:
            full = round(W * min(1, max(0, now - g["started"]) / max(1, e["likely"] - g["started"])))
            bar = "\u2588" * full + "\u2591" * (W - full)
            note = f"{e['left_min']:>2} min  {clock(e['likely'])}"
        rows.append((lab, bar, note))
        if e.get("tasks_total"):
            rows.append((f"  \u2514 {e['tasks_done']}/{e['tasks_total']} tasks done", None, None))
    w = max((len(r[0]) for r in rows if r[1]), default=0)
    print(f"Overall {clock(eta_all)} \u00b7 about {max(0, round((eta_all - now) / 60))} min left" if eta_all
          else "Nothing running" if not any(active(g) for g in tree) else "Running work: no estimate")
    if rows:
        print()
    for lab, bar, note in rows:
        print(f"{lab:<{w}}  {bar}  {note}" if bar else lab)
    sys.exit(0)


def eta_line(g):
    e = g["eta"]
    if g["stuck"]:
        return "eta: MAY BE STUCK, no estimate"
    if e["over"]:
        return f"eta: taking longer than usual (most finish within {round(p80s[g['id']])} min), from {e['basis_n']} past {e['basis']}"
    if not e["likely"]:
        return "eta: no estimate (fewer than 5 past runs of this type)"
    return (f"eta: likely {clock(e['likely'])} (~{e['left_min']} min left), latest {clock(e['latest'])} "
            f"(~{max(0, round((e['latest'] - now) / 60))} min), from "
            f"{(str(e['basis_n']) + (' of ' + str(e['basis_of']) if e['basis_n'] != e.get('basis_of') else '') + ' past ') if e['basis_n'] and e.get('method') != 'progress' else ''}"
            f"{e['basis']}")

if a.eta:
    L.append(f"all running work should be done by {clock(eta_all)} (~{max(0, round((eta_all - now) / 60))} min left), an estimate"
             + (f", {no_eta} more with no estimate" if no_eta else "")
             if eta_all else "nothing running" if not any(active(g) for g in tree) else "running work: no estimate")
for g in tree:
    ind = "  " * (1 + (g["depth"] - 1 if g["parent"] in byid else 0))
    st = "RUNNING" if g["running"] else "STOPPED" if g["died"] else "WAITING" if g["waits_on_children"] else "done"
    L.append(f"{ind}[{st}] {g['type']}{' [api]' if g['api'] else ''} - {short(g['desc'], 60)} (started {ago(g['started'])} ago, last write {ago(g['last_write'])} ago)")
    if a.eta and active(g):
        L.append(f"{ind}    {eta_line(g)}")
    if g["waiting"]:
        w = g["waiting"]
        L.append(f"{ind}    running `{short(w['what'] or w['tool'], 50)}` ({w['tool']}) for {ago(now - w['secs'])}")
    elif g["last_tool"]:
        L.append(f"{ind}    last tool: {short(g['last_tool'], 80)}")
    if g["text"]:
        L.append(f"{ind}    says: {g['text']}")
    if g["stuck"]:
        L.append(f"{ind}    MAY BE STUCK: silent {ago(g['last_write'])}, no tool call pending")
for r in runs[:3]:
    L.append(f"run {r['run']} (updated {ago(r['updated'])} ago): {r['status']}")
    L += [f"    {l}" for l in r["tail"]]
if tasks:
    L.append(f"tasks open: {len(tasks)}")
    L += [f"  #{t['id']} [{t['status']}] {t['subject']}" for t in tasks[:8]]
print("\n".join(L[:60]))
