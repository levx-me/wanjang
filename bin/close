#!/usr/bin/env bash
# SubagentStop hook: the wanjang may not report while a run log it wrote is still "in progress".
# It is sent back once to close the log (Status: done, or stopped with why); the second stop
# goes through (stop_hook_active), so it can never loop.
set -u
input=$(cat)
case "$(printf '%s' "$input" | jq -r '.agent_type // empty')" in wanjang:wanjang|wanjang) ;; *) exit 0 ;; esac
[ "$(printf '%s' "$input" | jq -r '.stop_hook_active // false')" = true ] && exit 0
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
dir=$(git -C "${cwd:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
# Logs this run could have written: touched in the last six hours.
open=$(find "$dir/wanjang" -maxdepth 2 -name log.md -mmin -360 2>/dev/null | xargs grep -l '^Status: in progress' 2>/dev/null | head -n 1)
[ -n "$open" ] || exit 0
jq -n --arg log "$open" '{decision: "block",
  reason: ("Your run log still says Status: in progress (" + $log + "). Set its first line to Status: done, or Status: stopped with why, then give your completion report.")}'
