#!/usr/bin/env bash
# apiKeyHelper for an Anthropic Console API key: prints the key from the OS secret store, never from a file.
# macOS keychain, then Linux secret-tool, then the ANTHROPIC_CONSOLE_API_KEY variable. Store it once with:
#   macOS:  security add-generic-password -s anthropic-console-claude -a "$USER" -w
#   Linux:  secret-tool store --label="Anthropic Console" service anthropic-console-claude
if command -v security >/dev/null && security find-generic-password -s anthropic-console-claude -a "$USER" -w 2>/dev/null; then exit 0; fi
if command -v secret-tool >/dev/null && secret-tool lookup service anthropic-console-claude 2>/dev/null; then exit 0; fi
[ -n "${ANTHROPIC_CONSOLE_API_KEY:-}" ] && { printf '%s\n' "$ANTHROPIC_CONSOLE_API_KEY"; exit 0; }
exit 1
