#!/usr/bin/env bash
# Per project (git toplevel of cwd, else cwd). /wanjang:crew-api on [--budget USD] | off | status. State: ${CLAUDE_CONFIG_DIR:-~/.claude}/wanjang/crew-api.json
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
cfg=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/wanjang
# Renamed from crew-console: move the old state file and logs dir on first use.
[ -e "$cfg/crew-api.json" ] || [ ! -e "$cfg/crew-console.json" ] || mv "$cfg/crew-console.json" "$cfg/crew-api.json"
[ -e "$cfg/crew-api" ] || [ ! -d "$cfg/crew-console" ] || mv "$cfg/crew-console" "$cfg/crew-api"
f=$cfg/crew-api.json
cmd=${1:-status}; [ $# -gt 0 ] && shift
proj=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
budget=$(jq -r --arg p "$proj" '.projects[$p].budget // 10' "$f" 2>/dev/null || echo 10)
set_state() {  # on|off
  mkdir -p "$cfg" && { cat "$f" 2>/dev/null || echo '{}'; } | jq --arg p "$proj" --argjson b "$budget" --argjson on "$1" '.projects[$p]={on:$on,budget:$b}' > "$f.tmp" && mv "$f.tmp" "$f"
}
case $cmd in
  on)
    if [ "${1:-}" = --budget ]; then budget=${2:-}; fi
    printf '%s' "$budget" | grep -Eq '^[0-9]+(\.[0-9]+)?$' && [ -n "$(printf '%s' "$budget" | tr -d '0.')" ] || { echo "crew-api: --budget must be a positive number (USD)" >&2; exit 2; }
    "$root/bin/api-key" >/dev/null 2>&1 || { echo "crew-api: no Console key stored; run /wanjang:provider key api first" >&2; exit 3; }
    set_state true
    echo "crew-api: on for $proj, budget \$$budget per run. wanjang agents now run as separate API-billed sessions." ;;
  off)
    set_state false
    echo "crew-api: off for $proj. wanjang agents use the session's own login again." ;;
  status)
    [ "$(jq -r --arg p "$proj" '.projects[$p].on // false' "$f" 2>/dev/null)" = true ] && s=on || s=off
    echo "crew-api: $s for $proj, budget \$$budget per run"
    ls -t "$cfg"/crew-api/*.json 2>/dev/null | head -5 | while IFS= read -r l; do
      jq -r --arg n "$(basename "$l")" 'if type=="array" then (map(select(.type=="result"))|last // {}) else . end | "  \($n): $\(.total_cost_usd // 0)"' "$l" 2>/dev/null
    done ;;
  *) echo "usage: crew-api on [--budget USD] | off | status" >&2; exit 2 ;;
esac
